<Project Sdk="Microsoft.NET.Sdk">
  <!--
    moodwave-helper: MoodWave for MIKU on macOS, which cannot load .NET modules. miku/extension.js starts it and talks
    to it in JSON lines (docs/macos.md). Published self-contained, one file per architecture:
      dotnet publish -c Release -r osx-x64   -o ../../miku/bin/osx-x64
      dotnet publish -c Release -r osx-arm64 -o ../../miku/bin/osx-arm64
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MoodChannels.Helper</RootNamespace>
    <AssemblyName>moodwave-helper</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MoodChannels.Service\MoodChannels.Service.csproj" />
  </ItemGroup>
</Project>
